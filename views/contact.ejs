<section class="section narrow">

  <h1 class="page-title">Subscribe to our Newsletter</h1>

  <p class="lead">
    Sign up to receive updates about our cooking classes,
    recipes, and special offers.
  </p>

  <form action="/subscribe" method="POST" class="contact-form">

    <label for="name">Your name</label>
    <input
      type="text"
      id="name"
      name="name"
      autocomplete="name"
      required
    >

    <label for="email">Email</label>
    <input
      type="email"
      id="email"
      name="email"
      autocomplete="email"
      required
    >

    <label for="zipCode">ZIP code</label>
    <input
      type="text"
      id="zipCode"
      name="zipCode"
      autocomplete="postal-code"
      required
    >

    <button class="button" type="submit">
      Subscribe
    </button>

  </form>

</section>